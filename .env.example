# Get this from @BotFather with /newbot
BOT_TOKEN=123456:ABC-your-token-here

# Your Telegram numeric id, from @userinfobot. Comma separated for more than one.
# Group admins can always post fixtures, this is just a manual override.
ADMIN_IDS=

# Where the SQLite file lives. On Railway, point this at a mounted volume.
DB_PATH=squad.db

TZ_NAME=Asia/Singapore

# How many hours before the deadline to chase non-responders.
# Set to 0.05 (3 minutes) when you are testing.
REMINDER_LEAD_HOURS=24
